  // POST /plans (GRA-66, handler/plans.rs): the whole plan validated first, every problem reported at once, in the
  // planner's order; then each item created under `plan:<id>:<name>`, so the same plan again creates nothing and
  // answers every name as existing.
  apply: () => {
    const errors = [];
    const id = plan.id.trim();
    if (!id || [...id].length > 100) errors.push('the plan needs an id of 1..=100 characters');
    const q = JSON.stringify;
    const refs = {}; // name -> level, for the plan's own items
    const named = [...plan.initiatives.map((x) => [x, 'initiative']), ...plan.epics.map((x) => [x, 'epic']), ...plan.stories.map((x) => [x, 'story'])];
    // What an earlier apply of this plan made under a name, or undefined.
    const earlier = (name) => state.creates[`plan:${id}:${name}`];
    for (const [x, t] of named) {
      const name = x.name;
      if (!name.trim() || name.trim() !== name) errors.push(`${t} name ${q(name)} must be non-empty with no surrounding spaces`);
      else if (KEY_REF.test(name)) errors.push(`${t} name ${q(name)} looks like a key; a name must not, so a reference is never ambiguous`);
      else if (name in refs) errors.push(`${q(name)} is used twice; every name in a plan names one item`);
      else refs[name] = t;
    }
    // A name keeps its level across applies of one plan id (check_name_levels).
    for (const [x, t] of named) {
      const made = refs[x.name] === t && earlier(x.name);
      if (made && made.key && kindOf(made) !== t) errors.push(`${q(x.name)} was ${kindOf(made) === 'story' ? 'a' : 'an'} ${kindOf(made)} (${made.key}) in an earlier apply of this plan; a name keeps its level`);
    }
    const decisionNames = new Set();
    for (const d of plan.decisions) {
      if (d.name in refs || decisionNames.has(d.name)) errors.push(`${q(d.name)} is used twice; every name in a plan names one item`);
      decisionNames.add(d.name);
    }
    // References, checked once every item's own rules are: [the reference, the level it must name (null: any), where].
    const pending = [];
    for (const x of plan.initiatives) {
      if (!x.title.trim()) errors.push(`initiative ${q(x.name)}: the title is required`);
      if (!HORIZONS.includes(x.horizon)) errors.push(`initiative ${q(x.name)}: horizon ${x.horizon} is not one of the configured buckets`);
    }
    for (const x of plan.epics) {
      if (!x.title.trim()) errors.push(`epic ${q(x.name)}: the title is required`);
      if (x.initiative !== undefined) pending.push([x.initiative, 'initiative', `epic ${q(x.name)}: initiative ${q(x.initiative)}`]);
    }
    for (const x of plan.stories) {
      const at = `story ${q(x.name)}`;
      if (!x.title.trim()) errors.push(`${at}: the title is required`);
      // A delivery state is a migrated ticket's (kb/ADR-0003): it needs the reference it came from, and done is the importer's.
      if (x.delivery !== undefined && x.external_ref === undefined) errors.push(`${at}: a delivery state requires an external_ref; only migrated work skips the gate`);
      if (x.delivery === 'done') errors.push(`${at}: delivery done is the importer's (it needs a resolution); a plan takes todo, in_progress, in_review or testing`);
      if (x.epic !== undefined) pending.push([x.epic, 'epic', `${at}: epic ${q(x.epic)}`]);
    }
    for (const d of plan.decisions) {
      if (!d.title.trim() || !d.decider.trim()) errors.push(`decision ${q(d.name)}: title and decider are required`);
      pending.push([d.on, null, `decision ${q(d.name)}: on ${q(d.on)}`]);
    }
    for (const b of plan.blocks) {
      const at = `block ${q(b.story)} by ${q(b.blocked_by)}`;
      if (b.story === b.blocked_by) errors.push(`${at}: a story cannot block itself`);
      pending.push([b.story, 'story', `${at}: story ${q(b.story)}`], [b.blocked_by, 'story', `${at}: story ${q(b.blocked_by)}`]);
    }
    // Item links and web links (kb/ADR-0031): at most 500 of each; each end an item of any level; no item link from an
    // item to itself; a web link's title and URL under the planner's rules, and a URL once per item, in the plan and stored.
    if (plan.links.length > 500) errors.push(`a plan holds at most 500 item links; this one has ${plan.links.length}`);
    if (plan.web_links.length > 500) errors.push(`a plan holds at most 500 web links; this one has ${plan.web_links.length}`);
    const linkAt = (l) => `item link ${q(l.from)} ${l.type} ${q(l.to)}`;
    // Where a web link's problem is: its title (trimmed, the first 40 characters) and its item, never its URL.
    const webAt = (w) => `web link ${q([...w.title.trim()].slice(0, 40).join(''))} on ${q(w.on)}`;
    for (const l of plan.links) pending.push([l.from, null, `${linkAt(l)}: from ${q(l.from)}`], [l.to, null, `${linkAt(l)}: to ${q(l.to)}`]);
    // As `WebLink::new`: the title is judged first and a bad one is reported alone; the URL only under a good title.
    const web = plan.web_links.map((w) => {
      const title = webTitle(w.title);
      const url = title === null ? null : webUrl(w.url);
      if (title === null) errors.push(`${webAt(w)}: ${WEB_TITLE}`); else if (url === null) errors.push(`${webAt(w)}: ${WEB_URL}`);
      pending.push([w.on, null, `${webAt(w)}: on ${q(w.on)}`]);
      return url === null ? null : { title, url };
    });
    // Each reference in the scope of the place it stands in: one spelling may be one item where a level is taken and
    // another where any level is (`Refs`), and neither answer serves the other.
    const existing = (r, wanted) => { const x = resolveRef(r, wanted); return x ? x.key : null; };
    for (const [r, wanted, at] of pending) {
      if (r in refs) { if (wanted && refs[r] !== wanted) errors.push(`${at} is a ${refs[r]} in the plan, not a ${wanted}`); continue; }
      if (!existing(r, wanted)) errors.push(`${at} is neither a name in the plan nor an existing ${wanted || 'item'}`);
    }
    // Which item an any-level reference names, as one comparable value (plan_identities): `key:` an item that exists,
    // an existing one however it is spelled or the one an earlier apply of this plan made under that name; `name:` a
    // plan item with no key yet. Undefined when it names nothing (reported above).
    const identity = (r) => {
      if (r in refs) { const made = earlier(r); return made && made.key ? `key:${made.key}` : `name:${r}`; }
      const k = existing(r, null);
      return k ? `key:${k}` : undefined;
    };
    for (const l of plan.links) {
      const [from, to] = [identity(l.from), identity(l.to)];
      if (from !== undefined && from === to) errors.push(`${linkAt(l)}: ${SELF_LINK}`);
    }
    const planned = {}; // identity -> the web links the plan's earlier entries give that item
    const stored = [];
    plan.web_links.forEach((w, i) => {
      const who = identity(w.on);
      if (!web[i] || who === undefined) return;
      const { title, url } = web[i];
      const before = (planned[who] ||= []).find((x) => x.url === url);
      if (!before) planned[who].push({ title, url });
      else if (before.title !== title) errors.push(`${webAt(w)}: the plan gives ${q(w.on)} that URL under two titles (${q(before.title)} and ${q(title)}); an item has a URL once`);
      if (who.startsWith('key:')) stored.push([w, who.slice(4), title, url]);
    });
    for (const [w, key, title, url] of stored) {
      const had = webLinksOf(key).find((x) => x.url === url);
      if (had && had.title !== title) errors.push(`${webAt(w)}: ${webSameUrl(had.title)}`);
    }
    if (errors.length) error('validation', errors.join('; '));
    const keys = {};
    const resolve = (r, wanted) => keys[r] || existing(r, wanted);
    const items = [];
    const make = (name, build) => withState((st) => {
      const k = `plan:${id}:${name}`;
      const created = !(k in st.creates);
      if (created) { st.creates[k] = build(st.next++); if (st.creates[k].key) (st.items ||= {})[st.creates[k].key] = st.creates[k]; }
      return { made: st.creates[k], created };
    });
    for (const x of plan.initiatives) {
      const { made, created } = make(x.name, (n) => initiative(`GRA-${n}`, x.title, { brief: x.brief || '', horizon: x.horizon, owner: x.owner || null, target_month: x.target_month || null, external_ref: x.external_ref || null }));
      keys[x.name] = made.key; items.push({ name: x.name, item: 'initiative', key: made.key, created });
    }
    for (const x of plan.epics) {
      const { made, created } = make(x.name, (n) => epic(`GRA-${n}`, x.title, { brief: x.brief || '', initiative: x.initiative !== undefined ? resolve(x.initiative, 'initiative') : null, external_ref: x.external_ref || null }));
      keys[x.name] = made.key; items.push({ name: x.name, item: 'epic', key: made.key, created });
    }
    // A story with a migrated ticket's state is created in that state, never moved there (the gate is not asked).
    for (const x of plan.stories) {
      const { made, created } = make(x.name, (n) => story(`GRA-${n}`, x.title, { kind: x.kind || 'story', epic: x.epic !== undefined ? resolve(x.epic, 'epic') : null, description: x.description || '', criteria: x.criteria.map((text) => ({ text, done: false })), labels: x.labels, external_ref: x.external_ref || null, delivery: x.delivery || 'todo' }));
      keys[x.name] = made.key; items.push({ name: x.name, item: 'story', key: made.key, created });
    }
    const decisions = plan.decisions.map((d) => {
      const on = resolve(d.on, null);
      const { made, created } = make(d.name, (n) => ({ ...decision7, id: n, on, on_type: refs[d.on] || typeOfKey(on), title: d.title, decider: d.decider, due: d.due || null, reversibility: d.reversibility || null }));
      return { name: d.name, id: made.id, created };
    });
    const blocks = plan.blocks.map((b) => withState((st) => {
      const [sk, bk] = [resolve(b.story, 'story'), resolve(b.blocked_by, 'story')];
      const s = (st.items || {})[sk] || stories[sk];
      const created = !s.blocked_by.includes(bk);
      if (created) (st.items ||= {})[sk] = { ...s, blocked_by: [...s.blocked_by, bk] };
      return { story: sk, blocked_by: bk, created };
    }));
    // Each item link and web link is its own write, after the items exist; one that is there answers `created` false.
    const levelIn = (st, k) => kindOf((st.items || {})[k] || initiatives[k] || epics[k] || stories[k]);
    const links = plan.links.map((l) => withState((st) => {
      const r = addLink(st, resolve(l.from, null), l.type, resolve(l.to, null));
      return { from: r.from, from_level: levelIn(st, r.from), type: r.type, to: r.to, to_level: levelIn(st, r.to), created: r.created };
    }));
    const webLinks = plan.web_links.map((w, i) => withState((st) => {
      const on = resolve(w.on, null);
      const r = addWeb(st, on, web[i].title, web[i].url);
      return { on, level: levelIn(st, on), id: r.link.id, title: r.link.title, url: r.link.url, created: r.created };
    }));
    ok({ items, decisions, blocks, links, web_links: webLinks });
  },
  // GET /search (GRA-73): title, brief or description, or external reference containing the text (case-insensitive,
  // literal), newest first, at most 50, each with the fields that matched.
  search: () => {
    const q = pos.join(' ').toLowerCase();
    const hits = [...all(initiatives, 'initiative'), ...all(epics, 'epic'), ...all(stories, 'story')].map((x) => {
      const item = kindOf(x);
      const fields = [['title', x.title], item === 'story' ? ['description', x.description] : ['brief', x.brief], ['external_ref', x.external_ref]];
      return { key: x.key, item, kind: item === 'story' ? x.kind : null, title: x.title, matched: fields.filter(([, v]) => v && v.toLowerCase().includes(q)).map(([n]) => n) };
    });
    ok(hits.filter((h) => h.matched.length).sort((a, b) => Number(b.key.split('-')[1]) - Number(a.key.split('-')[1])).slice(0, 50));
  },
