    const unreadable = process.env.REEVE_FAKE_LINK_CHECK === 'unreadable';
    const value = unreadable ? { ...linked, check: { kind: 'unchecked' }, checked_at: null } : { ...linked, check: { kind: f.pr ? 'proposed_pr_open' : 'not_found' }, checked_at: NOW };
