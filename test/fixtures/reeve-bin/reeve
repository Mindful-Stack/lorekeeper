  // GET /attachments/{id}, written to <dir>/<id>.<ext> (the ext from the stored type); an unknown id is not_found.
  'attachment get': () => {
    if (p0.toLowerCase() !== SHOT_ID) error('not_found', `no attachment ${p0}`);
    // --dir is required; the CLI creates it (recursively, mode 0700) and writes the image with mode 0600.
    fs.mkdirSync(f.dir, { recursive: true, mode: 0o700 });
    const file = path.join(f.dir, `${SHOT_ID}.png`);
    fs.copyFileSync(path.join(__dirname, 'shot.png'), file);
    fs.chmodSync(file, 0o600);
    ok({ path: file });
  },
