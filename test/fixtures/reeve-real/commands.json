    { "bind": "blocker", "argv": ["decision", "require", "--on", "{{story.key}}", "--title", "Skill smoke blocking decision", "--decider", "{{email}}", "--reversibility", "one-way", "--due", "2027-01-15", "--idempotency-key", "skill-smoke:SEED-1:{{run_id}}:6", "--json"] },
